{
	"schemaVersion": 1,
	"id": "hardwrought",
	"version": "${version}",
	"name": "Hardwrought",
	"description": "Hardcore survival from bare hands to the end of the game: smithing, metallurgy, magic, electricity and a reworked Nether, Underworld and End, guided by an in-game compendium. With an optional Ultra mode.",
	"authors": [
		"ipnats"
	],
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/hardwrought/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.ipnats.hardwrought.Hardwrought"
		],
		"client": [
			"de.ipnats.hardwrought.client.HardwroughtClient"
		],
		"fabric-datagen": [
			"de.ipnats.hardwrought.client.HardwroughtDataGenerator"
		]
	},
	"mixins": [
		"hardwrought.mixins.json",
		{
			"config": "hardwrought.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "hardwrought.sodium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"sodium": "*"
	}
}
