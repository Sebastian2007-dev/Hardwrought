{
	"schemaVersion": 1,
	"id": "hardwrought",
	"version": "${version}",
	"name": "Hardwrought",
	"description": "Hardcore survival, material progression and technology. Foundation for the Hardwrought total conversion.",
	"authors": [
		"ipnats"
	],
	"license": "CC0-1.0",
	"icon": "assets/hardwrought/icon.png",
