      "apply": {
        "model": "hardwrought:block/gas_line_titanium/arm_east"
      }
    },
    {
      "when": {
        "up": "connected"
      },
      "apply": {
        "model": "hardwrought:block/gas_line_titanium/arm_up"
      }
    },
    {
      "when": {
