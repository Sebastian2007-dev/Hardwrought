{
  "multipart": [
    {
      "apply": {
        "model": "hardwrought:block/forge_hood/plate"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/skirt_north"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/skirt_south"
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/skirt_west"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/skirt_east"
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "false"
          },
          {
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/corner_north_west"
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "false"
          },
          {
            "east": "false"
          }
        ]
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/corner_north_east"
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "false"
          },
          {
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/corner_south_west"
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "false"
          },
          {
            "east": "false"
          }
        ]
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/corner_south_east"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/collar"
      }
    },
    {
      "when": {
        "up": "false",
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": {
        "model": "hardwrought:block/forge_hood/stub"
      }
    }
  ]
}
